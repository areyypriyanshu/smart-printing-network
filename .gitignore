# Environment and secrets
.env
.env.*
!.env.example
# The production template is a deployment artefact, not a secret: it holds
# placeholders only, and an operator cannot fill in a file they cannot
# see.
!.env.prod.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.json
coverage.xml
htmlcov/

# Node
node_modules/
dist/
coverage/

# Playwright
test-results/
playwright-report/

# OS and editors
.DS_Store
.idea/
.vscode/

# AppleDouble files. macOS writes a companion file for anything that
# carries an extended attribute, and a tar created on a Mac carries one
# for every file in the archive. They are binary, they end in .py often
# enough for a tool to try to read them, and they are never wanted.
._*

# Local data
pgdata/
miniodata/
backups/

# Deployment secrets and machine-specific credentials. Keep the
# instance environment, tunnel credentials, account certificates and
# local bot credentials out of Git even if they are created below a
# subdirectory.
#
# The Cloudflare Tunnel configuration for a home deployment is one of
# them: the credentials are a secret and the tunnel id belongs to one
# box, so neither is in the repository.
# infra/home/make-tunnel-config.sh writes them.
.tunnel/
**/credentials/
*.pem
*.key
*.p12
*.pfx
*.token
telegram-chat-id

# Generated artefacts
openapi.json
.schemathesis/

# The generated knowledge graph of the repository. It is a map, not a source
# of truth, and it is rebuilt with `make graph`.
graphify-out/

# Docs
# The planning documents stay on this machine. The architecture decision
# records and the decisions page are published, because "explainable" is
# one of the three goals of this project and a decision nobody can read is
# not explained.
docs/*
!docs/adr/
!docs/DECISIONS.md
