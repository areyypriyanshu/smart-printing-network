# Template for the instance's .env in a production deployment.
#
# ENV is pinned by docker-compose.prod.yml as well; it is repeated here so
# the file is self-describing. Never commit the real .env.
#
# Fill every blank. The application refuses to start in production with a
# placeholder JWT secret, with the fake payment provider, with the console
# email sender or with the testing endpoints, and it will not start at all
# with an empty S3 endpoint.

ENV=production
LOG_LEVEL=INFO

# Generate this: openssl rand -base64 48
JWT_SECRET=

# Database and object storage credentials, and the ACME account address.
POSTGRES_USER=spn
POSTGRES_PASSWORD=
POSTGRES_DB=spn
# The application connects with this URL exactly as written, so the
# password has to be in it. Use a hex password (openssl rand -hex 16) so
# that no character has to be URL encoded.
DATABASE_URL=postgresql+psycopg://spn:@db:5432/spn
# The MinIO in docker-compose.prod.yml. It must not be empty: boto3
# rejects an empty endpoint. A deployment that uses a real private S3
# bucket puts that bucket's endpoint here.
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=spn-files
S3_ACCESS_KEY=spn
S3_SECRET_KEY=
ACME_EMAIL=

# The address Caddy serves. No scheme, no path, no trailing slash.
SPN_DOMAIN=

# The TLS mode. "internal" issues a certificate from Caddy's own
# authority, which a browser does not trust. For a real certificate this
# is the ACME account address, which is also what ACME_EMAIL is. It cannot
# be left empty: the Caddyfile turns it into a "tls" directive, and "tls"
# with no argument is a Caddyfile parse error.
SPN_TLS=

# The host ports Caddy is published on. The defaults are the public
# ones, which is what a VPS with a free port 80 wants. A host that
# already has something on port 80, or a deployment that is published
# through an outbound tunnel and therefore needs nothing on the public
# interface, sets these instead. The value is the host side of the
# mapping, so it may carry a bind address:
#   SPN_HTTP_PORT=127.0.0.1:8443
SPN_HTTP_PORT=80
SPN_HTTPS_PORT=443

# The networks whose forwarded headers Caddy believes. Empty on a VPS,
# where the browser is the only client and the address that opened the
# connection is the address to believe. A deployment behind a tunnel
# sets this to the tunnel's network, or the API would see the tunnel's
# address for every request, the rate limiter would count every visitor
# as one client, and one busy visitor could lock everyone else out.
SPN_TRUSTED_PROXIES=


# The database image and the processor it runs on. The official PostGIS
# image is published for amd64 only, so a deployment on an ARM instance
# (the free Oracle shape VM.Standard.A1.Flex is ARM) points these at a
# multi-arch image. The defaults are what an amd64 deployment uses.
SPN_DB_IMAGE=postgis/postgis:16-3.6
SPN_DB_PLATFORM=linux/amd64

# The real payment provider. Never 'fake' in production: the application
# refuses to start with the fake provider when ENV=production, because the
# fake provider's webhook key would be a key that is in the repository.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email. The console sender writes the verification link to the log, and
# that link is a secret, so production must use SMTP. Note that Oracle
# Cloud blocks outbound port 25, so the provider has to be a third party
# on port 587 or 465.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Whether the connection is encrypted from the first byte, which is the
# usual arrangement on port 465. Port 587 starts in the clear and
# upgrades with STARTTLS, which is what happens when this is off.
SMTP_USE_TLS=false

# Where a person opens a link from a message. It is the front door of
# the site.
APP_BASE_URL=

# Pay at the shop stays off until it is switched on deliberately.
CASH_AT_STORE_ENABLED=false

# The testing surface stays off. The application refuses to start when it
# is on in production.
TESTING_ENDPOINTS_ENABLED=false

# Phase 2. The browser's map key is restricted by the websites that may
# use it. The geocoding provider is chosen here: "nominatim" is free
# and needs no account, "google" needs the key below and a billing
# account, and "none" turns the lookup off and leaves the platform
# working without it.
GOOGLE_MAPS_API_KEY=
GEOCODING_PROVIDER=nominatim
GOOGLE_GEOCODING_API_KEY=
GEOCODING_USER_AGENT=SmartPrintingNetwork/1.0 (+https://github.com/areyypriyanshu/smart-printing-network)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_MIN_INTERVAL=1.0
