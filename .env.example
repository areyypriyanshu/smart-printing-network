# Copy to .env for local development: cp .env.example .env
# Never commit .env. Values below match docker-compose.yml defaults.

ENV=local
LOG_LEVEL=INFO

# Database (host "db" inside Compose; port 5432 is published for host tools)
DATABASE_URL=postgresql+psycopg://spn:spn@db:5432/spn
POSTGRES_USER=spn
POSTGRES_PASSWORD=spn
POSTGRES_DB=spn

# pgAdmin, the local database browser on http://localhost:5050. Local
# development only. Change the password before putting this anywhere else.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=spn

# Auth (placeholder only; generate your own with: openssl rand -base64 48)
JWT_SECRET=local-dev-placeholder-change-me-0123456789abcdef
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Object storage (MinIO locally; S3 in production)
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=spn-files
S3_ACCESS_KEY=spn
S3_SECRET_KEY=spn-local-secret

# Payments (fake gateway locally; Razorpay test mode needs all three values)
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# The key the fake gateway signs its webhooks with. The webhook route is
# public, so this key decides who may mark an order paid: it is a local
# development placeholder, and "make up" replaces it with a generated one.
# A production deployment uses Razorpay and never reads this value.
FAKE_WEBHOOK_SECRET=local-dev-placeholder-change-me-too-0123456789abcdef

# The testing surface: POST /testing/simulate-payment. The code default is
# off, so a deployment that has not been configured for it cannot expose it
# by accident. Local development turns it on; a production deployment must
# not, and the application refuses to start if it is on there.
TESTING_ENDPOINTS_ENABLED=true

# Pay at the shop. The code default is off, so a deployment that has not
# been configured for it cannot create a cash order by accident. Local
# development turns it on; a production deployment should start with it
# off and switch it on deliberately.
CASH_AT_STORE_ENABLED=true

# Limits and timeouts
MAX_UPLOAD_MB=50
MAX_PAGES=300
PAYMENT_TIMEOUT_MIN=15
ACCEPT_TIMEOUT_MIN=15
FILE_RETENTION_HOURS=24
# How long a ready cash order waits for the customer before it expires
NO_SHOW_TIMEOUT_HOURS=24

# The limits on creating an account. Registering is the most expensive
# thing an anonymous caller can ask for, because the password is hashed.
# The per address limits are generous on purpose: a campus shares one
# address. The last one is the total for the whole deployment, and it
# is what bounds the CPU spent on password hashes.
REGISTER_ADDRESS_PER_MINUTE=5
REGISTER_ADDRESS_PER_DAY=100
REGISTER_ACCOUNT_PER_HOUR=5
REGISTER_GLOBAL_PER_MINUTE=60

# Phase 2 (unused until then)
GOOGLE_MAPS_API_KEY=
