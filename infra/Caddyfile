# Caddy configuration for the single origin.
#
# The browser only ever talks to this one host, so there is no CORS to
# configure and the refresh cookie is always first party. Caddy obtains
# and renews the certificate on its own.
#
# SPN_DOMAIN  the domain to serve. Use localhost for a local run.
# SPN_TLS     "internal" for a local run, where Caddy issues from its own
#             authority. For a real certificate this is the ACME account
#             address, which is what ACME_EMAIL is. It cannot be left
#             empty: "tls" with no argument is a Caddyfile parse error.
# SPN_TRUSTED_PROXIES  the networks whose forwarded headers are believed.
#             Empty on a VPS, where the browser is the only client. A
#             deployment behind a tunnel sets it to the tunnel's network.
# CLERK_FAPI_URL  the identity provider's own host. The browser loads
#             the provider's script and talks to it from the page, so
#             the content security policy has to allow it. It has no
#             default, because a policy that allows the wrong host is a
#             policy that does not mean anything.

{
	# The address Caddy registers the ACME account with. It has to have a
	# value even when it is never used, because the local run issues its
	# own certificate and does not talk to ACME at all.
	email {$ACME_EMAIL:admin@localhost}

	# The proxies whose forwarded headers are believed, and the headers
	# the real client address is read from.
	#
	# On a VPS the browser is the only thing that connects, so the
	# address that opened the connection is the address to believe, and
	# this list is empty. Behind a tunnel the thing that connects is
	# the tunnel, and the real address arrives in a header the tunnel
	# sets, so the tunnel's network goes here.
	#
	# This matters because the API's rate limiter keys on the client
	# address. Without it, every visitor through a tunnel would count as
	# one client, and one busy visitor could lock everyone else out.
	servers {
		trusted_proxies static {$SPN_TRUSTED_PROXIES:}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$SPN_DOMAIN} {
	tls {$SPN_TLS}

	encode zstd gzip

	header {
		# Strict-Transport-Security tells the browser to only come back
		# over TLS. It is safe because this host is HTTPS only.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		# The policy allows the Razorpay checkout, the web fonts and the
		# identity provider, and nothing else from a third party. The app
		# itself ships no inline scripts.
		#
		# The provider's own host is needed in three places, and the
		# reasons are the provider's: it serves the script the browser
		# loads, the browser talks to it directly, and it frames its own
		# components. The hosts under protect.clerk.com are where the
		# provider's abuse and fraud protection lives, and the port
		# wildcard in connect-src is needed because they are not served
		# on 443. The images come from the provider's own host, and the
		# styles need unsafe-inline because the provider styles its
		# components at run time.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://checkout.razorpay.com {$CLERK_FAPI_URL} https://challenges.cloudflare.com https://*.protect.clerk.com; frame-src 'self' https://checkout.razorpay.com https://api.razorpay.com {$CLERK_FAPI_URL} https://challenges.cloudflare.com https://*.protect.clerk.com; connect-src 'self' https://api.razorpay.com {$CLERK_FAPI_URL} https://*.protect.clerk.com:*; img-src 'self' data: https://img.clerk.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# The API answers under /api. The webhook has to be reachable from the
	# public internet, so it is not behind an extra path check here.
	handle /api/* {
		# The API's own limit is MAX_UPLOAD_MB, and the edge must not
		# forward a body the application would refuse anyway. Caddy reads
		# MB as a megabyte of a million bytes, so 54MB is above both the
		# application's 51 MiB cap and the 50 MB file limit it enforces.
		request_body {
			max_size 54MB
		}
		reverse_proxy api:8000
	}

	# Health checks for the uptime monitor and for the deploy smoke
	# check. The readiness check also reports whether the database and the
	# object storage are reachable, which is operational information and
	# nothing more.
	handle /healthz {
		reverse_proxy api:8000
	}

	handle /readyz {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
