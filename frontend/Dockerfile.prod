# Production image for the frontend.
#
# The first stage builds the single page app. The second stage is Caddy
# itself, serving the built files. One web server on the origin means one
# place for TLS, the security headers and the content security policy, and
# it means the browser never makes a cross origin request.

FROM node:22-alpine AS build

WORKDIR /app

# The publishable key is public: it is in the browser's bundle either
# way, and it can only be used to ask the provider who someone is. It
# is a build argument because the bundle is built once and served as
# static files, so it cannot be read from the environment at run time.
ARG VITE_CLERK_PUBLISHABLE_KEY=""
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY

# The map key is public as well, and it is a build argument for the
# same reason: the bundle is built once and served as static files.
ARG VITE_GOOGLE_MAPS_API_KEY=""
ENV VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY


COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM caddy:2.10-alpine

COPY --from=build /app/dist /srv
