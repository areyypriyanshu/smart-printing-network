# Production image for the frontend.
#
# The first stage builds the single page app. The second stage is Caddy
# itself, serving the built files. One web server on the origin means one
# place for TLS, the security headers and the content security policy, and
# it means the browser never makes a cross origin request.

FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM caddy:2.10-alpine

COPY --from=build /app/dist /srv
